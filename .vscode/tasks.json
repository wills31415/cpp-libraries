{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compiler",
            "type": "shell",
            "command": "cmake --preset debug && cmake --build --preset debug -j",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$gcc",
            "presentation": { "clear": true }
        },
        {
            "label": "Tests",
            "type": "shell",
            "command": "ctest --preset debug",
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "Compiler",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Tests (Release)",
            "type": "shell",
            "command": "cmake --preset release && cmake --build --preset release -j && ctest --preset release",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test",
            "problemMatcher": "$gcc",
            "presentation": { "clear": true }
        },
        {
            "label": "Exécuter le test courant",
            "type": "shell",
            "command": "${workspaceFolder}/build/debug/tests/${fileBasenameNoExtension}",
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "Compiler",
            "problemMatcher": []
        },
        {
            "label": "Installer dans ~/.local",
            "type": "shell",
            "command": "cmake --preset release && cmake --build --preset release -j && ctest --preset release && cmake --install build/release --prefix ~/.local",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$gcc",
            "presentation": { "clear": true }
        },
        {
            "label": "Nettoyer",
            "type": "shell",
            "command": "rm -rf ${workspaceFolder}/build",
            "problemMatcher": []
        }
    ]
}
