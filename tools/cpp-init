#!/usr/bin/env bash
# cpp-init — initialise un projet C++23 (CMake + clangd + lldb) pour VSCode sur macOS.
#
# Usage : cpp-init [options] [répertoire]        (répertoire courant par défaut)
#   -n, --name NOM   nom de l'exécutable (défaut : nom du répertoire sans « cpp- »)
#   --no-git         ne pas lancer git init
#   --no-build       ne pas vérifier par une configuration + compilation + ctest
#   --no-wsl         ne pas brancher les bibliothèques wsl (cpp-libraries)
#   -f, --force      écraser les fichiers existants (sinon ils sont conservés)
#   -h, --help       afficher cette aide
#
# Exemples :
#   cpp-init ~/projets/cpp-mon-jeu     crée le projet « mon_jeu » et le vérifie
#   cpp-init                           initialise le répertoire courant
#
# Bibliothèques wsl : par défaut, le projet récupère cpp-libraries par FetchContent,
# figé sur la dernière version publiée (tag vX.Y.Z), et toutes ses cibles voient
# wsl::libraries. Le preset « debug-wsl-local » (CMakeUserPresets.json, non suivi
# par git) utilise à la place le clone local de cpp-libraries, pour modifier une
# bibliothèque en même temps que le projet.
#
# Pour les prochains projets :
#   - Ce script est versionné dans cpp-libraries/tools/ ; ~/.local/bin/cpp-init (déjà
#     dans le PATH) n'est qu'un lien vers lui. Il ne dépend pas de Claude.
#   - Dans Claude Code, le skill /cpp-init (~/.claude/skills/cpp-init/) le lance :
#     demander « initialise un projet C++ » suffit.
#   - Les fichiers existants ne sont jamais écrasés sans --force : relancer le
#     script sur un projet existant ne fait qu'ajouter ce qui manque.
#   - Pour changer la configuration par défaut, modifier uniquement ce script.
#     Un besoin propre à un projet (bibliothèque externe…) va dans le
#     CMakeLists.txt de ce projet, pas ici.
#   - Le détail de ce qui est généré est dans le README.md de chaque projet.

set -euo pipefail

info() { printf '\033[36m[cpp-init]\033[0m %s\n' "$*"; }
warn() { printf '\033[33m[cpp-init]\033[0m %s\n' "$*"; }
err()  { printf '\033[31m[cpp-init] %s\033[0m\n' "$*" >&2; exit 1; }

name="" git=1 build=1 force=0 wsl=1 dir="."
while (($#)); do
    case "$1" in
        -n|--name) name="${2:?--name attend une valeur}"; shift 2 ;;
        --no-git) git=0; shift ;;
        --no-build) build=0; shift ;;
        --no-wsl) wsl=0; shift ;;
        -f|--force) force=1; shift ;;
        -h|--help) sed -n '2,/^$/p' "$0" | sed -e '/^$/d' -e 's/^# \{0,1\}//'; exit 0 ;;
        -*) err "option inconnue : $1" ;;
        *) dir="$1"; shift ;;
    esac
done

mkdir -p "$dir"
cd "$dir"
root="$PWD"
[[ -n "$name" ]] || name="$(basename "$root")"
name="${name#cpp-}"
name="$(printf '%s' "$name" | tr -c 'A-Za-z0-9_\n' '_')"   # identifiant CMake valide
[[ "$name" =~ ^[A-Za-z_] ]] || name="_$name"
NAME="$(printf '%s' "$name" | tr a-z A-Z)"

# Compilateur d'Apple imposé : /opt/miniconda3/bin passe avant /usr/bin dans le PATH
# et son clang++/make ne trouvent pas le SDK macOS correctement.
CXX=/usr/bin/clang++
[[ -x "$CXX" ]] || err "$CXX introuvable : installer les Command Line Tools (xcode-select --install)"
command -v cmake >/dev/null || err "cmake introuvable"

# Bibliothèques wsl : dernière version publiée sur GitHub, à défaut dernier tag du
# clone local (ce script vit dans cpp-libraries/tools/, ~/.local/bin n'en a qu'un lien).
WSL_URL="https://github.com/wills31415/cpp-libraries.git"
wsl_repo="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
wsl_tag=""
if ((wsl)); then
    wsl_tag="$(git ls-remote --tags --refs --sort=-v:refname "$WSL_URL" 'v*' 2>/dev/null \
               | head -1 | sed 's|.*refs/tags/||')" || true
    if [[ -z "$wsl_tag" && -d "$wsl_repo/.git" ]]; then
        wsl_tag="$(git -C "$wsl_repo" tag --list 'v*' --sort=-v:refname | head -1)"
        [[ -n "$wsl_tag" ]] && warn "GitHub injoignable : version wsl du clone local ($wsl_tag)"
    fi
    if [[ -z "$wsl_tag" ]]; then
        warn "aucune version de cpp-libraries trouvée : projet créé sans les bibliothèques wsl"
        wsl=0
    fi
fi

wsl_cmake=""
if ((wsl)); then
    wsl_cmake="
# Bibliothèques génériques wsl (cpp-libraries), figées sur une version : la changer
# ici pour monter de version (voir son CHANGELOG.md). Pour travailler sur le clone
# local à la place, utiliser le preset debug-wsl-local (CMakeUserPresets.json).
include(FetchContent)
FetchContent_Declare(wsl_libraries
    GIT_REPOSITORY ${WSL_URL}
    GIT_TAG        ${wsl_tag}
    GIT_SHALLOW    TRUE
    EXCLUDE_FROM_ALL)
FetchContent_MakeAvailable(wsl_libraries)
target_link_libraries(${name}_options INTERFACE wsl::libraries)
"
fi

wsl_readme="" wsl_claude=""
if ((wsl)); then
    wsl_readme="- **Bibliothèques wsl** ([cpp-libraries](${WSL_URL%.git})), version \`${wsl_tag}\`,
  récupérées par FetchContent et visibles de toutes les cibles : \`#include <wsl/array2d.hpp>\`…
  - Monter de version : changer \`GIT_TAG\` dans \`CMakeLists.txt\` (voir le \`CHANGELOG.md\`
    de cpp-libraries).
  - Modifier une bibliothèque en même temps que ce projet : preset **debug-wsl-local**
    (\`cmake --preset debug-wsl-local\`), qui utilise le clone local \`${wsl_repo/#$HOME/~}\`.
    Il est défini dans \`CMakeUserPresets.json\`, propre à cette machine et non suivi par git.
"
    wsl_claude="- Bibliothèques wsl (cpp-libraries, \`${wsl_tag}\`) par FetchContent, liées à
  \`${name}_options\` : réutiliser \`wsl::\` plutôt que réécrire du code générique. Le
  preset \`debug-wsl-local\` utilise le clone local \`${wsl_repo/#$HOME/~}\`.
"
fi

# write FICHIER : écrit l'entrée standard dans FICHIER, sauf s'il existe déjà.
write() {
    if [[ -e "$1" && $force -eq 0 ]]; then
        warn "conservé : $1"
        cat >/dev/null
        return
    fi
    mkdir -p "$(dirname "$1")"
    cat >"$1"
    info "écrit    : $1"
}

info "projet « $name » dans $root"

write CMakeLists.txt <<EOF
cmake_minimum_required(VERSION 3.28)
project(${name} LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 23)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

option(${NAME}_SANITIZERS "Compiler avec AddressSanitizer et UBSan" OFF)

# Options communes à toutes les cibles du projet.
add_library(${name}_options INTERFACE)
target_compile_options(${name}_options INTERFACE -Wall -Wextra -Wpedantic)
if(${NAME}_SANITIZERS)
    target_compile_options(${name}_options INTERFACE -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(${name}_options INTERFACE -fsanitize=address,undefined)
endif()
${wsl_cmake}
# Tous les .cpp de src/ sont compilés : il suffit d'y ajouter des fichiers.
# src/main.cpp contient main() ; le reste forme une bibliothèque partagée avec les tests.
file(GLOB_RECURSE CORE_SOURCES CONFIGURE_DEPENDS "\${CMAKE_SOURCE_DIR}/src/*.cpp")
list(REMOVE_ITEM CORE_SOURCES "\${CMAKE_SOURCE_DIR}/src/main.cpp")

if(CORE_SOURCES)
    add_library(${name}_core STATIC \${CORE_SOURCES})
    target_include_directories(${name}_core PUBLIC "\${CMAKE_SOURCE_DIR}/src")
    target_link_libraries(${name}_core PUBLIC ${name}_options)
else()
    # Pas encore de .cpp hors main.cpp : bibliothèque « en-têtes seuls ».
    add_library(${name}_core INTERFACE)
    target_include_directories(${name}_core INTERFACE "\${CMAKE_SOURCE_DIR}/src")
    target_link_libraries(${name}_core INTERFACE ${name}_options)
endif()

add_executable(${name} src/main.cpp)
target_link_libraries(${name} PRIVATE ${name}_core)

# Chaque tests/*.cpp devient un exécutable de test autonome (un main() qui
# renvoie 0 en cas de succès), lancé par ctest.
enable_testing()
file(GLOB TEST_SOURCES CONFIGURE_DEPENDS "\${CMAKE_SOURCE_DIR}/tests/*.cpp")
foreach(test_source IN LISTS TEST_SOURCES)
    get_filename_component(test_name "\${test_source}" NAME_WE)
    add_executable(\${test_name} "\${test_source}")
    target_link_libraries(\${test_name} PRIVATE ${name}_core)
    set_target_properties(\${test_name} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "\${CMAKE_BINARY_DIR}/tests")
    # Les assert restent actifs dans les tests, même en Release (qui définit NDEBUG).
    target_compile_options(\${test_name} PRIVATE -UNDEBUG)
    add_test(NAME \${test_name} COMMAND \${test_name})
endforeach()
EOF

