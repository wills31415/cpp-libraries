#!/usr/bin/env bash
# Refuse un push dont le code n'est pas un état vérifié vert par tools/check.sh
# (build/check-passed : les derniers états vérifiés) ; un push qui ne diffère d'un tel état
# que par de la documentation (cmake/ci_ignored_paths.txt) passe, comme un push qui ne change
# pas le contenu de la branche distante (une branche recalée par rebase). Les tags et les
# suppressions passent.
# Activation, une fois par clone : git config core.hooksPath tools/git-hooks
# Contourner exceptionnellement : git push --no-verify
set -euo pipefail
root=$(git rev-parse --show-toplevel)
passed=$(tail -1 "$root/build/check-passed" 2>/dev/null || true)
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "$local_sha" == "$zero" || "$local_ref" == refs/tags/* ]] && continue
    tree=$(git rev-parse "$local_sha^{tree}")
    grep -qx "$tree" "$root/build/check-passed" 2>/dev/null && continue
    if [[ "$remote_sha" != "$zero" ]] && git cat-file -e "$remote_sha" 2>/dev/null &&
       [[ "$(git rev-parse "$remote_sha^{tree}")" == "$tree" ]]; then
        continue   # même contenu que la branche distante : recalage par rebase
    fi
    if [[ -n "$passed" ]] && git cat-file -e "$passed" 2>/dev/null; then
        code=$(git diff --name-only "$passed" "$tree" | grep -v -E -f "$root/cmake/ci_ignored_paths.txt" || true)
    else
        code=$(git diff --name-only "$(git merge-base origin/main "$local_sha")" "$local_sha" |
               grep -v -E -f "$root/cmake/ci_ignored_paths.txt" || true)
    fi
    [[ -z "$code" ]] && continue
    echo "pre-push : ${local_ref#refs/heads/} n'est pas l'état vérifié par tools/check.sh ; fichiers en cause :" >&2
    printf '  %s\n' $code | head -10 >&2
    echo "Lancer tools/check.sh (ou, exceptionnellement, git push --no-verify)." >&2
    exit 1
done
